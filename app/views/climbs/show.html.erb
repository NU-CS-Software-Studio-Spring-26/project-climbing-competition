<% content_for :title, "Climb Details" %>

<section class="page-header text-center">
  <h1 class="page-title">climb details</h1>
</section>

<div class="action-row mb-2 d-flex gap-2 flex-wrap align-items-center">
  <%= link_to competition_path(@competition), class: "back-arrow-text-link" do %>
    <span aria-hidden="true">←</span>
    back to competition details
  <% end %>
</div>

<div class="detail-panel p-4 mb-3">
  <p class="detail-item mb-2"><span>Competition:</span> <%= @competition.name %></p>
  <p class="detail-item mb-2"><span>Climb:</span> <%= @climb.name %></p>
  <p class="detail-item mb-0"><span>Open on Kilter:</span> <a href="<%= @climb.url %>" target="_blank" rel="noopener noreferrer"><%= @climb.url %></a></p>
</div>

<div class="detail-panel p-4 mb-3">
  <h2 class="detail-heading mb-3">Climb Visual</h2>
  <div class="kilter-board-preview" data-controller="kilter-board" data-kilter-board-editable-value="false" data-kilter-board-assignments-value="<%= @climb.hold_assignments.to_json %>">
    <div class="kilter-board-image-wrap">
      <img src="/kilter-board.svg" alt="Kilter board" class="kilter-board-image" data-kilter-board-target="image">
      <div class="kilter-board-overlay" data-kilter-board-target="overlay"></div>
    </div>
  </div>
</div>

<% if authenticated? && current_user.competitions.include?(@competition) %>
  <div class="detail-panel p-4 mb-3">
    <h2 class="detail-heading mb-3">Log your attempt</h2>

    <% if @attempt&.errors&.any? %>
      <div class="alert alert-danger" role="alert">
        <h2 class="h6"><%= pluralize(@attempt.errors.count, "error") %> prevented this attempt from being saved:</h2>
        <ul class="mb-0">
          <% @attempt.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <% if @attempt&.persisted? %>
      <p class="detail-item mb-3"><span>Your current log:</span> <%= @attempt.attempt_count %> attempts, <%= @attempt.completed? ? "completed" : "not completed" %>, <%= @attempt.points_awarded %> points</p>
    <% end %>

    <%= form_with url: competition_climb_attempt_path(@competition, @climb), scope: :attempt, method: @attempt&.persisted? ? :patch : :post, html: { class: "board-form" } do |form| %>
      <div class="mb-3">
        <%= form.label :attempt_count, "Attempts (Max 100)", class: "form-label" %>
        <%= form.number_field :attempt_count, class: "form-control", min: 1, max: Attempt::MAX_ATTEMPT_COUNT, step: 1, required: true,
              inputmode: "numeric",
              onkeydown: "if (['e','E','+','-','.'].includes(event.key)) event.preventDefault()",
              oninput: "if (this.value !== '' && Number(this.value) > #{Attempt::MAX_ATTEMPT_COUNT}) this.value = #{Attempt::MAX_ATTEMPT_COUNT}" %>
      </div>

      <div class="mb-3 form-check">
        <%= form.check_box :completed, class: "form-check-input", id: "attempt_completed" %>
        <%= form.label :completed, "Completed the climb", class: "form-check-label", for: "attempt_completed" %>
      </div>

      <%= form.submit(@attempt&.persisted? ? "Update attempt" : "Save attempt", class: "btn btn-primary") %>
    <% end %>
  </div>
<% end %>

