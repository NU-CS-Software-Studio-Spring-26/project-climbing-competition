<div id="<%= dom_id competition %>" role="article" aria-label="<%= competition.name %>">
  <div>
    <strong id="<%= dom_id competition %>-name">Name:</strong>
    <span aria-labelledby="<%= dom_id competition %>-name">
      <%= competition.name %>
    </span>
  </div>

  <div>
    <strong id="<%= dom_id competition %>-start">Starts:</strong>
    <time aria-labelledby="<%= dom_id competition %>-start" datetime="<%= competition.competition_start.iso8601 %>">
      <%= competition.competition_start %>
    </time>
  </div>

  <div>
    <strong id="<%= dom_id competition %>-end">Ends:</strong>
    <time aria-labelledby="<%= dom_id competition %>-end" datetime="<%= competition.competition_end.iso8601 %>">
      <%= competition.competition_end %>
    </time>
  </div>

  <div>
    <strong id="<%= dom_id competition %>-difficulty">Difficulty:</strong>
    <span aria-labelledby="<%= dom_id competition %>-difficulty">
      V<%= competition.difficulty %>
    </span>
  </div>

</div>