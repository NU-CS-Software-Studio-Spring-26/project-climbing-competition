<%= form_with(model: competition, html: { class: "board-form", data: { competition_edit_form: true } }) do |form| %>
  <% input_class = ->(field_name, base = "form-control") { [ base, ("border border-danger" if competition.errors[field_name].any?) ].compact.join(" ") } %>
  <% if competition.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <h2 class="h6"><%= pluralize(competition.errors.count, "error") %> prevented this competition from being saved:</h2>
      <ul class="mb-0">
        <% competition.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="board-form-block">
    <h2 class="board-form-block-title">General Information</h2>

    <div class="board-form-field board-form-field--name" data-controller="char-counter" data-char-counter-max-value="100">
      <%= form.label :name, class: "form-label" %>
      <%= form.text_field :name, class: input_class.call(:name), placeholder: "Example: Regional Boulder Jam",
            maxlength: 100,
            required: true,
            data: { char_counter_target: "input", action: "input->char-counter#update" } %>
      <% competition.errors.full_messages_for(:name).each do |message| %>
        <div class="text-danger small mt-1"><%= message %></div>
      <% end %>
      <span class="char-counter" data-char-counter-target="count"></span>
    </div>

    <div class="board-form-field">
      <div class="row g-3">
        <div class="col-sm-6">
          <%= form.label :starts_at_date, "Start Date", class: "form-label" %>
          <%= form.date_field :starts_at_date, value: competition.starts_at&.to_date, class: input_class.call(:starts_at), required: true %>
        </div>
        <div class="col-sm-6">
          <%= form.label :starts_at_time, "Start Time", class: "form-label" %>
          <%= form.time_field :starts_at_time, value: competition_time_field_value(competition.starts_at), class: input_class.call(:starts_at), required: true %>
        </div>
      </div>
      <% competition.errors.full_messages_for(:starts_at).each do |message| %>
        <div class="text-danger small mt-1"><%= message %></div>
      <% end %>
    </div>

    <div class="board-form-field board-form-field--last">
      <div class="row g-3">
        <div class="col-sm-6">
          <%= form.label :ends_at_date, "End Date", class: "form-label" %>
          <%= form.date_field :ends_at_date, value: competition.ends_at&.to_date, class: input_class.call(:ends_at), required: true %>
        </div>
        <div class="col-sm-6">
          <%= form.label :ends_at_time, "End Time", class: "form-label" %>
          <%= form.time_field :ends_at_time, value: competition_time_field_value(competition.ends_at), class: input_class.call(:ends_at), required: true %>
        </div>
      </div>
      <% competition.errors.full_messages_for(:ends_at).each do |message| %>
        <div class="text-danger small mt-1"><%= message %></div>
      <% end %>
    </div>
  </div>

  <div class="board-form-block">
    <h2 class="board-form-block-title">Existing Climbs</h2>
    <p class="board-form-hint mb-2">These climbs stay as published. You can add more below.</p>

    <ul class="competition-edit-climb-list mb-0">
      <% competition.climbs.reject(&:new_record?).each do |climb| %>
        <li class="competition-edit-climb-list__item">
          <span class="competition-edit-climb-list__name"><%= climb.name %></span>
          <span class="competition-edit-climb-list__grade"><%= climb.grading %></span>
        </li>
      <% end %>
    </ul>
  </div>

  <div class="board-form-block">
    <h2 class="board-form-block-title">Add Climbs</h2>
    <div class="competition-edit-grade-notice" role="note">
      New climbs must use grades within <strong><%= competition.locked_grade_range_label %></strong>.
      This range was set when the competition was created and cannot be changed.
    </div>

    <div id="climbs-container">
      <%= form.fields_for :climbs, competition.climbs.select(&:new_record?) do |climb_form| %>
        <%= render "climb_fields", form: climb_form,
              locked_grade_min: competition.v_grade_min,
              locked_grade_max: competition.v_grade_max,
              allow_remove: true %>
      <% end %>
    </div>

    <template id="climb-template">
      <%= form.fields_for :climbs, Climb.new, child_index: "NEW_RECORD" do |climb_form| %>
        <%= render "climb_fields", form: climb_form,
              locked_grade_min: competition.v_grade_min,
              locked_grade_max: competition.v_grade_max,
              allow_remove: true %>
      <% end %>
    </template>

    <button type="button" class="btn btn-sm btn-board-secondary" id="add-climb-btn">+ Add Climb</button>
  </div>

  <div class="action-row d-flex gap-2 flex-wrap">
    <%= form.submit "Update Competition", class: "btn btn-board-primary" %>
    <%= link_to "Cancel", competition, class: "btn btn-board-secondary" %>
  </div>
<% end %>

<script>
function initializeCompetitionEditForm() {
  const formEl = document.querySelector("form[data-competition-edit-form]");
  if (!formEl || formEl.dataset.competitionEditFormInitialized === "true") return;
  formEl.dataset.competitionEditFormInitialized = "true";

  const addClimbBtn = formEl.querySelector("#add-climb-btn");
  const climbsContainer = formEl.querySelector("#climbs-container");
  const climbTemplate = formEl.querySelector("#climb-template");

  function attachDeleteHandler(deleteBtn) {
    deleteBtn.addEventListener("click", function(e) {
      e.preventDefault();
      deleteBtn.closest("[data-climb-field]")?.remove();
    });
  }

  formEl.querySelectorAll(".delete-climb-btn").forEach(btn => {
    attachDeleteHandler(btn);
  });

  if (addClimbBtn) {
    addClimbBtn.addEventListener("click", function(e) {
      e.preventDefault();
      if (!climbTemplate || !climbsContainer) return;

      const timestamp = Date.now();
      const climbHTML = climbTemplate.innerHTML.replace(/NEW_RECORD/g, String(timestamp));
      climbsContainer.insertAdjacentHTML("beforeend", climbHTML);

      const newDeleteBtn = climbsContainer.querySelector(`[data-climb-field]:last-child .delete-climb-btn`);
      if (newDeleteBtn) attachDeleteHandler(newDeleteBtn);
    });
  }
}

if (!window.__competitionEditFormListenerBound) {
  document.addEventListener("turbo:load", initializeCompetitionEditForm);
  window.__competitionEditFormListenerBound = true;
}

initializeCompetitionEditForm();
</script>
