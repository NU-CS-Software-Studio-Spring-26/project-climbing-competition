<%= form_with(model: competition, html: { class: "board-form" }) do |form| %>
  <% input_class = ->(field_name, base = "form-control") { [ base, ("border border-danger" if competition.errors[field_name].any?) ].compact.join(" ") } %>
  <% if competition.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <h2 class="h6"><%= pluralize(competition.errors.count, "error") %> prevented this competition from being saved:</h2>
      <ul class="mb-0">
        <% competition.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="board-form-block">
    <h2 class="board-form-block-title">General Information</h2>

    <div class="board-form-field board-form-field--name" data-controller="char-counter" data-char-counter-max-value="100">
      <%= form.label :name, class: "form-label" %>
      <%= form.text_field :name, class: input_class.call(:name), placeholder: "Example: Regional Boulder Jam",
            maxlength: 100,
            required: true,
            data: { char_counter_target: "input", action: "input->char-counter#update" } %>
      <% competition.errors.full_messages_for(:name).each do |message| %>
        <div class="text-danger small mt-1"><%= message %></div>
      <% end %>
      <span class="char-counter" data-char-counter-target="count"></span>
    </div>

    <div class="board-form-field">
      <div class="row g-3">
        <div class="col-sm-6">
          <%= form.label :starts_at_date, "Start Date", class: "form-label" %>
          <%= form.date_field :starts_at_date, value: competition.starts_at&.to_date, class: input_class.call(:starts_at), required: true %>
        </div>
        <div class="col-sm-6">
          <%= form.label :starts_at_time, "Start Time", class: "form-label" %>
          <%= form.time_field :starts_at_time, value: competition.starts_at&.strftime("%H:%M"), class: input_class.call(:starts_at), required: true %>
        </div>
      </div>
      <% competition.errors.full_messages_for(:starts_at).each do |message| %>
        <div class="text-danger small mt-1"><%= message %></div>
      <% end %>
    </div>

    <div class="board-form-field">
      <div class="row g-3">
        <div class="col-sm-6">
          <%= form.label :ends_at_date, "End Date", class: "form-label" %>
          <%= form.date_field :ends_at_date, value: competition.ends_at&.to_date, class: input_class.call(:ends_at), required: true %>
        </div>
        <div class="col-sm-6">
          <%= form.label :ends_at_time, "End Time", class: "form-label" %>
          <%= form.time_field :ends_at_time, value: competition.ends_at&.strftime("%H:%M"), class: input_class.call(:ends_at), required: true %>
        </div>
      </div>
      <% competition.errors.full_messages_for(:ends_at).each do |message| %>
        <div class="text-danger small mt-1"><%= message %></div>
      <% end %>
    </div>

    <div class="board-form-field board-form-field--last" data-controller="char-counter" data-char-counter-max-value="2000">
      <%= form.label :description, class: "form-label" %>
      <%= form.text_area :description, class: "form-control", placeholder: "Describe this competition...", rows: 4,
            maxlength: 2000,
            data: { char_counter_target: "input", action: "input->char-counter#update" } %>
      <span class="char-counter" data-char-counter-target="count"></span>
    </div>
  </div>

  <div class="board-form-block">
    <h2 class="board-form-block-title">Scoring Settings</h2>

    <div class="board-form-field">
      <%= form.label :send_points, "Points for a Send", class: "form-label" %>
      <div class="d-flex align-items-center gap-3">
        <%= form.range_field :send_points, min: 0, max: 50, step: 1,
              class: "form-range flex-grow-1",
              data: { scoring_slider: "send_points" } %>
        <%= form.number_field :send_points, min: 0, max: 50, step: 1,
              class: [ "scoring-number", ("border border-danger" if competition.errors[:send_points].any?) ].compact.join(" "),
              required: true,
              data: { scoring_number: "send_points" } %>
      </div>
      <% competition.errors.full_messages_for(:send_points).each do |message| %>
        <div class="text-danger small mt-1"><%= message %></div>
      <% end %>
      <div class="form-text">Base points for completing a problem (not on the first attempt).</div>
    </div>

    <div class="board-form-field">
      <%= form.label :flash_points, "Points for a Flash", class: "form-label" %>
      <div class="d-flex align-items-center gap-3">
        <%= form.range_field :flash_points, min: 0, max: 50, step: 1,
              class: "form-range flex-grow-1",
              data: { scoring_slider: "flash_points" } %>
        <%= form.number_field :flash_points, min: 0, max: 50, step: 1,
              class: [ "scoring-number", ("border border-danger" if competition.errors[:flash_points].any?) ].compact.join(" "),
              required: true,
              data: { scoring_number: "flash_points" } %>
      </div>
      <% competition.errors.full_messages_for(:flash_points).each do |message| %>
        <div class="text-danger small mt-1"><%= message %></div>
      <% end %>
      <div class="form-text">Points for completing a problem on the very first attempt.</div>
    </div>

    <div class="board-form-field">
      <%= form.label :attempt_deduction, "Points Deducted per Extra Attempt", class: "form-label" %>
      <div class="d-flex align-items-center gap-3">
        <%= form.range_field :attempt_deduction, min: 0, max: 10, step: 1,
              class: "form-range flex-grow-1",
              data: { scoring_slider: "attempt_deduction" } %>
        <%= form.number_field :attempt_deduction, min: 0, max: 10, step: 1,
              class: [ "scoring-number", ("border border-danger" if competition.errors[:attempt_deduction].any?) ].compact.join(" "),
              required: true,
              data: { scoring_number: "attempt_deduction" } %>
      </div>
      <% competition.errors.full_messages_for(:attempt_deduction).each do |message| %>
        <div class="text-danger small mt-1"><%= message %></div>
      <% end %>
      <div class="form-text">Deducted for each attempt after the first (0 = no penalty).</div>
    </div>

    <div class="scoring-preview">
      <span>
        Flash = <strong data-preview="flash">–</strong> pts &nbsp;|&nbsp;
        Send on 2nd attempt = <strong data-preview="send2">–</strong> pts &nbsp;|&nbsp;
        Send on 3rd attempt = <strong data-preview="send3">–</strong> pts
      </span>
    </div>
  </div>

  <div class="board-form-block">
    <h2 class="board-form-block-title">Climbs</h2>
    <p class="board-form-hint">Competition level and difficulty range are set automatically from the V-grades on your climbs.</p>
    <div id="climbs-container">
      <%= form.fields_for :climbs do |climb_form| %>
        <%= render "climb_fields", form: climb_form %>
      <% end %>
    </div>

    <template id="climb-template">
      <%= form.fields_for :climbs, Climb.new, child_index: "NEW_RECORD" do |climb_form| %>
        <%= render "climb_fields", form: climb_form %>
      <% end %>
    </template>

    <button type="button" class="btn btn-sm btn-board-secondary" id="add-climb-btn">+ Add Climb</button>
  </div>

  <div class="action-row d-flex gap-2 flex-wrap">
    <%= form.submit competition.new_record? ? "Create Competition" : "Update Competition", class: "btn btn-board-primary", id: "submit-btn" %>
    <%= link_to "Cancel", competitions_path, class: "btn btn-board-secondary" %>
  </div>
<% end %>

<script>
function initializeCompetitionForm() {
  const formEl = document.querySelector("form.board-form");
  if (!formEl || formEl.dataset.competitionFormInitialized === "true") return;
  formEl.dataset.competitionFormInitialized = "true";

  // ── Scoring sliders ──────────────────────────────────────────────────────────
  function getSlider(name) {
    return formEl.querySelector(`[data-scoring-slider="${name}"]`);
  }
  function getNumber(name) {
    return formEl.querySelector(`[data-scoring-number="${name}"]`);
  }

  function updateScoringPreview() {
    const send   = parseInt(getNumber("send_points")?.value)       || 0;
    const flash  = parseInt(getNumber("flash_points")?.value)      || 0;
    const deduct = parseInt(getNumber("attempt_deduction")?.value) || 0;

    const previewFlash = formEl.querySelector('[data-preview="flash"]');
    const previewSend2 = formEl.querySelector('[data-preview="send2"]');
    const previewSend3 = formEl.querySelector('[data-preview="send3"]');

    if (previewFlash) previewFlash.textContent = flash;
    if (previewSend2) previewSend2.textContent = Math.max(send - deduct, 0);
    if (previewSend3) previewSend3.textContent = Math.max(send - 2 * deduct, 0);
  }

  function syncPair(name) {
    const slider = getSlider(name);
    const number = getNumber(name);
    if (!slider || !number) return;

    slider.value = number.value;

    slider.addEventListener("input", function () {
      number.value = slider.value;
      updateScoringPreview();
    });

    number.addEventListener("input", function () {
      const clamped = Math.min(
        Math.max(parseInt(number.value) || parseInt(slider.min), parseInt(slider.min)),
        parseInt(slider.max)
      );
      number.value = clamped;
      slider.value = clamped;
      updateScoringPreview();
    });
  }

  syncPair("send_points");
  syncPair("flash_points");
  syncPair("attempt_deduction");
  updateScoringPreview();
  // ────────────────────────────────────────────────────────────────────────────

  const addClimbBtn = formEl.querySelector("#add-climb-btn");
  const climbsContainer = formEl.querySelector("#climbs-container");
  const climbTemplate = formEl.querySelector("#climb-template");
  const submitBtn = formEl.querySelector("#submit-btn");

  function validateClimbCount() {
    if (!climbsContainer) return;
    const climbCount = climbsContainer.querySelectorAll('[data-climb-field]').length;
    const hasMinimumClimbs = climbCount >= 2;
    
    if (submitBtn) {
      submitBtn.disabled = !hasMinimumClimbs;
      if (!hasMinimumClimbs) {
        submitBtn.title = `You must add at least 2 climbs (current: ${climbCount})`;
      } else {
        submitBtn.title = "";
      }
    }
  }

  function attachDeleteHandler(deleteBtn) {
    deleteBtn.addEventListener("click", function(e) {
      e.preventDefault();
      const climbField = deleteBtn.closest('[data-climb-field]');
      const destroyInput = climbField.querySelector('input[name*="_destroy"]');
      
      if (destroyInput) {
        destroyInput.value = "true";
      }
      
      climbField.remove();
      validateClimbCount();
    });
  }

  formEl.querySelectorAll('.delete-climb-btn').forEach(btn => {
    attachDeleteHandler(btn);
  });

  if (addClimbBtn) {
    addClimbBtn.addEventListener("click", function(e) {
      e.preventDefault();

      if (!climbTemplate || !climbsContainer) return;

      const timestamp = Date.now();

      const climbHTML = climbTemplate.innerHTML.replace(/NEW_RECORD/g, String(timestamp));
      climbsContainer.insertAdjacentHTML("beforeend", climbHTML);

      const newDestroyInput = climbsContainer.querySelector(`input[name="competition[climbs_attributes][${timestamp}][_destroy]"]`);
      const newDeleteBtn = newDestroyInput?.closest('[data-climb-field]')?.querySelector('.delete-climb-btn');
      if (newDeleteBtn) {
        attachDeleteHandler(newDeleteBtn);
      }

      validateClimbCount();
    });
  }

  validateClimbCount();
}

if (!window.__competitionFormListenerBound) {
  document.addEventListener("turbo:load", initializeCompetitionForm);
  window.__competitionFormListenerBound = true;
}

initializeCompetitionForm();
</script>