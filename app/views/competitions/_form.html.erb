<%= form_with(model: competition, html: { class: "board-form" }) do |form| %>
  <% if competition.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <h2 class="h6"><%= pluralize(competition.errors.count, "error") %> prevented this competition from being saved:</h2>
      <ul class="mb-0">
        <% competition.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: "form-control", placeholder: "Example: Regional Boulder Jam" %>
  </div>

  <div class="mb-3">
    <div class="row">
      <div class="col">
        <%= form.label :starts_at_date, "Start Date", class: "form-label" %>
        <%= form.date_field :starts_at_date, value: competition.starts_at&.to_date, class: "form-control" %>
      </div>
      <div class="col">
        <%= form.label :starts_at_time, "Start Time", class: "form-label" %>
        <%= form.time_field :starts_at_time, value: competition.starts_at&.strftime("%H:%M"), class: "form-control" %>
      </div>
    </div>
  </div>

  <div class="mb-3">
    <div class="row">
      <div class="col">
        <%= form.label :ends_at_date, "End Date", class: "form-label" %>
        <%= form.date_field :ends_at_date, value: competition.ends_at&.to_date, class: "form-control" %>
      </div>
      <div class="col">
        <%= form.label :ends_at_time, "End Time", class: "form-label" %>
        <%= form.time_field :ends_at_time, value: competition.ends_at&.strftime("%H:%M"), class: "form-control" %>
      </div>
    </div>
  </div>

  <div class="mb-3">
    <%= form.label :level, "Comp Level", class: "form-label" %>
    <%= form.select :level,
        options_for_select(Competition::LEVELS.map { |level| [level.titleize, level] }, competition.level),
        { prompt: "Select a level" },
        class: "form-select",
        required: true %>
  </div>

  <div class="mb-3">
    <%= form.label :description, class: "form-label" %>
    <%= form.text_area :description, class: "form-control", placeholder: "Describe this competition...", rows: 4 %>
  </div>

  <!-- Climbs Section -->
  <div class="climbs-section mb-4">
    <h3 class="mb-3">Climbs</h3>
    <div id="climbs-container">
      <%= form.fields_for :climbs do |climb_form| %>
        <%= render "climb_fields", form: climb_form %>
      <% end %>
    </div>
    <button type="button" class="btn btn-sm btn-board-secondary mt-3" id="add-climb-btn">+ Add Climb</button>
  </div>

  <div class="action-row d-flex gap-2 flex-wrap">
    <%= form.submit competition.new_record? ? "Create Competition" : "Update Competition", class: "btn btn-board-primary", id: "submit-btn" %>
    <%= link_to "Cancel", competitions_path, class: "btn btn-board-secondary" %>
  </div>
<% end %>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const addClimbBtn = document.getElementById("add-climb-btn");
  const climbsContainer = document.getElementById("climbs-container");
  const submitBtn = document.getElementById("submit-btn");

  function validateClimbCount() {
    const climbCount = climbsContainer.querySelectorAll('[data-climb-field]').length;
    const hasMinimumClimbs = climbCount >= 2;
    
    if (submitBtn) {
      submitBtn.disabled = !hasMinimumClimbs;
      if (!hasMinimumClimbs) {
        submitBtn.title = `You must add at least 2 climbs (current: ${climbCount})`;
      } else {
        submitBtn.title = "";
      }
    }
  }

  function attachDeleteHandler(deleteBtn) {
    deleteBtn.addEventListener("click", function(e) {
      e.preventDefault();
      const climbField = deleteBtn.closest('[data-climb-field]');
      const destroyInput = climbField.querySelector('input[name*="_destroy"]');
      
      if (destroyInput) {
        // Mark as destroyed so Rails knows to delete it
        destroyInput.value = "true";
      }
      
      // Remove the climb field from the DOM
      climbField.remove();
      
      // Validate climb count after deletion
      validateClimbCount();
    });
  }

  // Attach handlers to existing delete buttons
  document.querySelectorAll('.delete-climb-btn').forEach(btn => {
    attachDeleteHandler(btn);
  });

  if (addClimbBtn) {
    addClimbBtn.addEventListener("click", function(e) {
      e.preventDefault();
      
      // Get the current timestamp for unique field names
      const timestamp = Date.now();
      
      // Create new climb field HTML with delete button
      const climbHTML = `
        <div class="climb-field mb-3 p-3 border rounded" data-climb-field>
          <div class="d-flex justify-content-between align-items-start mb-2">
            <h5 class="mb-0">Climb</h5>
            <button type="button" class="btn btn-sm btn-outline-danger delete-climb-btn" data-climb-id="">
              <span aria-hidden="true">×</span> Remove
            </button>
          </div>

          <div class="mb-2">
            <label class="form-label" for="climb_name_${timestamp}">Climb Name</label>
            <input class="form-control" type="text" name="competition[climbs_attributes][${timestamp}][name]" id="climb_name_${timestamp}" placeholder="e.g., The Crimper">
          </div>

          <div class="mb-2">
            <label class="form-label" for="climb_grading_${timestamp}">V-Grade</label>
            <input class="form-control" type="text" name="competition[climbs_attributes][${timestamp}][grading]" id="climb_grading_${timestamp}" placeholder="e.g., V4, V5" pattern="^V\\d{1,2}$" title="V-grade format: V0-V99 (e.g., V4, V7)">
          </div>

          <div class="mb-0">
            <label class="form-label" for="climb_url_${timestamp}">Climb Link (URL)</label>
            <input class="form-control" type="text" name="competition[climbs_attributes][${timestamp}][url]" id="climb_url_${timestamp}" placeholder="https://...">
          </div>

          <input type="hidden" name="competition[climbs_attributes][${timestamp}][_destroy]" value="false">
        </div>
      `;
      
      // Add the new field
      climbsContainer.insertAdjacentHTML("beforeend", climbHTML);
      
      // Attach delete handler to the newly added button
      const newDeleteBtn = climbsContainer.querySelector(`input[name="competition[climbs_attributes][${timestamp}][_destroy]"]`).closest('[data-climb-field]').querySelector('.delete-climb-btn');
      if (newDeleteBtn) {
        attachDeleteHandler(newDeleteBtn);
      }
      
      // Validate climb count after adding
      validateClimbCount();
    });
  }

  // Initial validation on page load
  validateClimbCount();
});
</script>


