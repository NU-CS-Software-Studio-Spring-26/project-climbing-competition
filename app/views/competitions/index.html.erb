<% content_for :title, "active events" %>

<% filters_active = @sort_by.present? || @selected_status.present? || @grade_filter_active %>

<div class="competitions-filter-bar mb-3">
  <div class="filter-dropdown" data-controller="filter-menu">
    <button
      type="button"
      class="btn-filter<%= " btn-filter--active" if filters_active %>"
      data-filter-menu-target="button"
      data-action="filter-menu#toggle"
      aria-expanded="false"
      aria-haspopup="true"
      id="competitionsFilterToggle"
    >
      Filter
      <% if filters_active %>
        <span class="filter-active-dot" aria-hidden="true"></span>
      <% end %>
    </button>

    <div class="filter-menu" data-filter-menu-target="menu" aria-labelledby="competitionsFilterToggle">
      <div class="filter-menu-section">
        <span class="sort-label">Status</span>
        <div class="level-buttons-group">
          <%= link_to "All", competitions_path(@filter_params.except(:status)), class: "btn-level #{@selected_status.blank? ? "btn-level-active" : ""}" %>
          <% { "upcoming" => "Upcoming", "ongoing" => "Active", "past" => "Past" }.each do |value, label| %>
            <%= link_to label, competitions_path(@filter_params.merge(status: value)), class: "btn-level #{@selected_status == value ? "btn-level-active" : ""}" %>
          <% end %>
        </div>
      </div>

      <div class="filter-menu-section">
        <span class="sort-label">Date</span>
        <div class="sort-buttons-group">
          <%= link_to competitions_path(next_sort_params("starts_at")), class: "btn-sort-date #{@sort_by == "starts_at" ? "btn-sort-active" : ""}" do %>
            <span>Start</span>
            <span class="sort-arrow">
              <% if @sort_by == "starts_at" %>
                <%= @sort_direction == "asc" ? "↑" : "↓" %>
              <% else %>
                <span class="sort-arrow-inactive">↕</span>
              <% end %>
            </span>
          <% end %>

          <%= link_to competitions_path(next_sort_params("ends_at")), class: "btn-sort-date #{@sort_by == "ends_at" ? "btn-sort-active" : ""}" do %>
            <span>End</span>
            <span class="sort-arrow">
              <% if @sort_by == "ends_at" %>
                <%= @sort_direction == "asc" ? "↑" : "↓" %>
              <% else %>
                <span class="sort-arrow-inactive">↕</span>
              <% end %>
            </span>
          <% end %>
        </div>
      </div>

      <div class="filter-menu-section">
        <span class="sort-label">Difficulty</span>
        <%= form_with url: competitions_path, method: :get,
              html: {
                class: "grade-range-filter",
                data: { controller: "grade-range-filter" }
              } do %>
          <% if @sort_by.present? %>
            <%= hidden_field_tag :sort_by, @sort_by %>
            <%= hidden_field_tag :sort_direction, @sort_direction if @sort_direction.present? %>
          <% end %>
          <%= hidden_field_tag :status, @selected_status if @selected_status.present? %>

          <div class="grade-range-slider">
            <div class="grade-range-slider__labels">
              <span data-grade-range-filter-target="minLabel"><%= v_grade_label(@grade_range_min) %></span>
              <span data-grade-range-filter-target="maxLabel"><%= v_grade_label(@grade_range_max) %></span>
            </div>

            <div
              class="grade-range-slider__control"
              data-grade-range-filter-target="control"
              style="--range-min: <%= @grade_range_min / 16.0 %>; --range-max: <%= @grade_range_max / 16.0 %>;"
            >
              <div class="grade-range-slider__rail" aria-hidden="true"></div>
              <div class="grade-range-slider__fill" aria-hidden="true"></div>
              <%= range_field_tag :grade_min, @grade_range_min,
                    min: 0, max: 16, step: 1,
                    class: "grade-range-slider__input grade-range-slider__input--min",
                    data: {
                      grade_range_filter_target: "min",
                      action: "pointerdown->grade-range-filter#pointerDown input->grade-range-filter#update change->grade-range-filter#apply"
                    },
                    aria: { label: "Minimum difficulty" } %>
              <%= range_field_tag :grade_max, @grade_range_max,
                    min: 0, max: 16, step: 1,
                    class: "grade-range-slider__input grade-range-slider__input--max",
                    data: {
                      grade_range_filter_target: "max",
                      action: "pointerdown->grade-range-filter#pointerDown input->grade-range-filter#update change->grade-range-filter#apply"
                    },
                    aria: { label: "Maximum difficulty" } %>
            </div>

            <div class="grade-range-slider__bounds" aria-hidden="true">
              <span>V0</span>
              <span>V10+</span>
            </div>
          </div>
        <% end %>
      </div>

      <% if filters_active %>
        <div class="filter-menu-footer">
          <%= link_to "Clear all", competitions_path, class: "btn-filter-clear" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<div class="row gx-4 gy-5 competitions-grid">
  <% @competitions.each do |competition| %>
    <div class="col-12 col-md-6 col-xl-4">
      <article class="competition-card competition-card--<%= competition.grade_range_tier.to_s.dasherize %> h-100 d-flex flex-column">
        <div class="competition-top-border" aria-hidden="true"></div>
        <%= link_to competition_path(competition), class: "competition-card-link-overlay" do %>
          <div class="competition-body flex-grow-1">
            <div class="d-flex align-items-start justify-content-between gap-2 mb-1">
              <h2 class="competition-name mb-0"><%= competition.name %></h2>
              <span class="competition-status-badge competition-status-badge--<%= competition.status %>" aria-label="Status: <%= competition.status %>">
                <%= competition.status.to_s.titleize %>
              </span>
            </div>
            <p class="competition-date">Difficulty: V<%= competition.v_grade_min %>–V<%= competition.v_grade_max == 10 ? "10+" : competition.v_grade_max %></p>
            <p class="competition-date">Climbers: <%= competition.users.count %></p>
            <p class="competition-date">Starts: <%= competition.starts_at&.strftime("%b %-d, %Y") %></p>
            <p class="competition-date">Ends: <%= competition.ends_at&.strftime("%b %-d, %Y") %></p>
          </div>
        <% end %>
        
        <% if authenticated? %>
          <div class="competition-action-buttons">
            <% if current_user.competitions.include?(competition) %>
              <% enrollment = competition.enrollments.find_by(user: current_user) %>
              <button type="button" class="btn-leave-competition" data-competition-id="<%= competition.id %>" data-enrollment-id="<%= enrollment.id %>" data-competition-name="<%= competition.name %>">
                LEAVE
              </button>
            <% else %>
              <button type="button" class="btn-join-competition" data-competition-id="<%= competition.id %>" data-competition-name="<%= competition.name %>">
                JOIN
              </button>
            <% end %>
          </div>
        <% end %>
      </article>
    </div>
  <% end %>
</div>

<div class="pagination-container mt-5 mb-5 d-flex justify-content-center">
  <%= paginate @competitions, params: @filter_params %>
</div>

<!-- Join Confirmation Modal -->
<div id="joinModal" class="modal-overlay" style="display: none;">
  <div class="modal-content">
    <h2 class="modal-title">Join Competition</h2>
    <p class="modal-message">Are you sure you want to join <strong id="joinCompetitionName"></strong>?</p>
    <div class="modal-buttons">
      <button type="button" class="modal-btn-cancel">Cancel</button>
      <form id="joinForm" method="post" style="display: inline;">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <button type="submit" class="modal-btn-confirm">Join</button>
      </form>
    </div>
  </div>
</div>

<!-- Leave Confirmation Modal -->
<div id="leaveModal" class="modal-overlay" style="display: none;">
  <div class="modal-content">
    <h2 class="modal-title">Leave Competition</h2>
    <p class="modal-message">Are you sure you want to leave <strong id="leaveCompetitionName"></strong>?</p>
    <div class="modal-buttons">
      <button type="button" class="modal-btn-cancel">Cancel</button>
      <form id="leaveForm" method="post" style="display: inline;">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <input type="hidden" name="_method" value="delete">
        <button type="submit" class="modal-btn-confirm modal-btn-danger">Leave</button>
      </form>
    </div>
  </div>
</div>

<script>
  function initializeEnrollmentButtons() {
    const joinModal = document.getElementById('joinModal');
    const leaveModal = document.getElementById('leaveModal');
    const joinForm = document.getElementById('joinForm');
    const leaveForm = document.getElementById('leaveForm');

    if (!joinModal || !leaveModal || !joinForm || !leaveForm) {
      console.error('Modal elements not found');
      return;
    }

    // Remove old listeners by cloning and replacing buttons
    document.querySelectorAll('.btn-join-competition').forEach(btn => {
      const newBtn = btn.cloneNode(true);
      btn.replaceWith(newBtn);
    });

    document.querySelectorAll('.btn-leave-competition').forEach(btn => {
      const newBtn = btn.cloneNode(true);
      btn.replaceWith(newBtn);
    });

    // Join button handlers
    document.querySelectorAll('.btn-join-competition').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const competitionId = this.dataset.competitionId;
        const competitionName = this.dataset.competitionName;
        
        if (!competitionId) {
          console.error('Missing competition ID');
          return;
        }
        
        document.getElementById('joinCompetitionName').textContent = competitionName;
        joinForm.action = `/competitions/${competitionId}/enrollments`;
        joinModal.style.display = 'flex';
      });
    });

    // Leave button handlers
    document.querySelectorAll('.btn-leave-competition').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const competitionId = this.dataset.competitionId;
        const enrollmentId = this.dataset.enrollmentId;
        const competitionName = this.dataset.competitionName;
        
        if (!competitionId || !enrollmentId) {
          console.error('Missing competition ID or enrollment ID');
          return;
        }
        
        document.getElementById('leaveCompetitionName').textContent = competitionName;
        leaveForm.action = `/competitions/${competitionId}/enrollments/${enrollmentId}`;
        leaveModal.style.display = 'flex';
      });
    });

    // Modal cancel buttons
    document.querySelectorAll('.modal-btn-cancel').forEach(btn => {
      btn.addEventListener('click', function() {
        joinModal.style.display = 'none';
        leaveModal.style.display = 'none';
      });
    });

    // Close modal when clicking outside
    [joinModal, leaveModal].forEach(modal => {
      if (modal) {
        modal.addEventListener('click', function(e) {
          if (e.target === this) {
            this.style.display = 'none';
          }
        });
      }
    });
  }

  // Initialize on page load
  document.addEventListener('DOMContentLoaded', initializeEnrollmentButtons);

  // Re-initialize on Turbo navigation
  document.addEventListener('turbo:load', initializeEnrollmentButtons);
  document.addEventListener('turbo:render', initializeEnrollmentButtons);
</script>
