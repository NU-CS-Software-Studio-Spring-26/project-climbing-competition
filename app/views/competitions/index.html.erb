<% content_for :title, "active events" %>

<section class="page-header text-center">
  <h1 class="page-title">active events</h1>
</section>

<div class="sort-filters-container mb-3">
  <div class="sort-section">
    <span class="sort-label">Date:</span>
    <div class="sort-buttons-group">
      <% 
        # Toggle logic for sort buttons
        start_new_sort_by = @sort_by == 'starts_at' ? nil : 'starts_at'
        start_direction = @sort_by == 'starts_at' && @sort_direction == 'desc' ? 'asc' : 'desc'
        end_new_sort_by = @sort_by == 'ends_at' ? nil : 'ends_at'
        end_direction = @sort_by == 'ends_at' && @sort_direction == 'desc' ? 'asc' : 'desc'
      %>
      <%= link_to competitions_path(sort_by: start_new_sort_by, sort_direction: (start_new_sort_by.present? ? start_direction : nil), level: @selected_levels.presence), class: "btn-sort-date #{@sort_by == 'starts_at' ? 'btn-sort-active' : ''}" do %>
        <span>Start</span>
        <span class="sort-arrow">
          <% if @sort_by == 'starts_at' %>
            <%= @sort_direction == 'asc' ? '↑' : '↓' %>
          <% else %>
            <span style="opacity: 0.5;">↕</span>
          <% end %>
        </span>
      <% end %>
      
      <%= link_to competitions_path(sort_by: end_new_sort_by, sort_direction: (end_new_sort_by.present? ? end_direction : nil), level: @selected_levels.presence), class: "btn-sort-date #{@sort_by == 'ends_at' ? 'btn-sort-active' : ''}" do %>
        <span>End</span>
        <span class="sort-arrow">
          <% if @sort_by == 'ends_at' %>
            <%= @sort_direction == 'asc' ? '↑' : '↓' %>
          <% else %>
            <span style="opacity: 0.5;">↕</span>
          <% end %>
        </span>
      <% end %>
    </div>
  </div>

  <div class="level-section">
    <span class="sort-label">Level:</span>
    <div class="level-buttons-group">
      <%= link_to "All", competitions_path(sort_by: @sort_by, sort_direction: @sort_direction), class: "btn-level #{@selected_levels.blank? ? 'btn-level-active' : ''}" %>
      <% Competition::LEVELS.each do |level| %>
        <% 
          # Build levels array with or without this level
          new_levels = if @selected_levels.include?(level)
            @selected_levels - [level]
          else
            @selected_levels + [level]
          end
        %>
        <%= link_to level.titleize, competitions_path(sort_by: @sort_by, sort_direction: @sort_direction, level: new_levels.presence), class: "btn-level #{@selected_levels.include?(level) ? 'btn-level-active' : ''}" %>
      <% end %>
    </div>
  </div>
</div>

<div class="row g-4 competitions-grid">
  <% @competitions.each do |competition| %>
    <div class="col-12 col-md-6 col-xl-4">
      <article class="competition-card h-100 d-flex flex-column">
        <div class="competition-top-border" aria-hidden="true"></div>
        <div class="competition-body flex-grow-1">
          <h2 class="competition-name"><%= competition.name %></h2>
          <p class="competition-date">Level: <%= competition.level.to_s.titleize %></p>
          <p class="competition-date">Climbers: <%= competition.users.count %></p>
          <p class="competition-date">Starts: <%= competition.starts_at&.strftime("%b %-d, %Y") %></p>
          <p class="competition-date">Ends: <%= competition.ends_at&.strftime("%b %-d, %Y") %></p>
          <div class="competition-links">
            <%= link_to "View Details", competition_path(competition), class: "competition-link" %>
          </div>
        </div>
        
        <% if authenticated? %>
          <div class="competition-action-buttons">
            <% if current_user.competitions.include?(competition) %>
              <% enrollment = competition.enrollments.find_by(user: current_user) %>
              <button type="button" class="btn-leave-competition" data-competition-id="<%= competition.id %>" data-enrollment-id="<%= enrollment.id %>" data-competition-name="<%= competition.name %>">
                Leave Competition
              </button>
            <% else %>
              <button type="button" class="btn-join-competition" data-competition-id="<%= competition.id %>" data-competition-name="<%= competition.name %>">
                Join Competition
              </button>
            <% end %>
          </div>
        <% end %>
      </article>
    </div>
  <% end %>
</div>

<div class="pagination-container mt-5 mb-5 d-flex justify-content-center">
  <%= paginate @competitions, params: { sort_by: @sort_by, sort_direction: @sort_direction, level: @selected_levels.presence } %>
</div>

<!-- Join Confirmation Modal -->
<div id="joinModal" class="modal-overlay" style="display: none;">
  <div class="modal-content">
    <h2 class="modal-title">Join Competition</h2>
    <p class="modal-message">Are you sure you want to join <strong id="joinCompetitionName"></strong>?</p>
    <div class="modal-buttons">
      <button type="button" class="modal-btn-cancel">Cancel</button>
      <form id="joinForm" method="post" style="display: inline;">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <button type="submit" class="modal-btn-confirm">Join</button>
      </form>
    </div>
  </div>
</div>

<!-- Leave Confirmation Modal -->
<div id="leaveModal" class="modal-overlay" style="display: none;">
  <div class="modal-content">
    <h2 class="modal-title">Leave Competition</h2>
    <p class="modal-message">Are you sure you want to leave <strong id="leaveCompetitionName"></strong>?</p>
    <div class="modal-buttons">
      <button type="button" class="modal-btn-cancel">Cancel</button>
      <form id="leaveForm" method="post" style="display: inline;">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <input type="hidden" name="_method" value="delete">
        <button type="submit" class="modal-btn-confirm modal-btn-danger">Leave</button>
      </form>
    </div>
  </div>
</div>

<script>
  function initializeEnrollmentButtons() {
    const joinModal = document.getElementById('joinModal');
    const leaveModal = document.getElementById('leaveModal');
    const joinForm = document.getElementById('joinForm');
    const leaveForm = document.getElementById('leaveForm');

    if (!joinModal || !leaveModal || !joinForm || !leaveForm) {
      console.error('Modal elements not found');
      return;
    }

    // Remove old listeners by cloning and replacing buttons
    document.querySelectorAll('.btn-join-competition').forEach(btn => {
      const newBtn = btn.cloneNode(true);
      btn.replaceWith(newBtn);
    });

    document.querySelectorAll('.btn-leave-competition').forEach(btn => {
      const newBtn = btn.cloneNode(true);
      btn.replaceWith(newBtn);
    });

    // Join button handlers
    document.querySelectorAll('.btn-join-competition').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const competitionId = this.dataset.competitionId;
        const competitionName = this.dataset.competitionName;
        
        if (!competitionId) {
          console.error('Missing competition ID');
          return;
        }
        
        document.getElementById('joinCompetitionName').textContent = competitionName;
        joinForm.action = `/competitions/${competitionId}/enrollments`;
        joinModal.style.display = 'flex';
      });
    });

    // Leave button handlers
    document.querySelectorAll('.btn-leave-competition').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const competitionId = this.dataset.competitionId;
        const enrollmentId = this.dataset.enrollmentId;
        const competitionName = this.dataset.competitionName;
        
        if (!competitionId || !enrollmentId) {
          console.error('Missing competition ID or enrollment ID');
          return;
        }
        
        document.getElementById('leaveCompetitionName').textContent = competitionName;
        leaveForm.action = `/competitions/${competitionId}/enrollments/${enrollmentId}`;
        leaveModal.style.display = 'flex';
      });
    });

    // Modal cancel buttons
    document.querySelectorAll('.modal-btn-cancel').forEach(btn => {
      btn.addEventListener('click', function() {
        joinModal.style.display = 'none';
        leaveModal.style.display = 'none';
      });
    });

    // Close modal when clicking outside
    [joinModal, leaveModal].forEach(modal => {
      if (modal) {
        modal.addEventListener('click', function(e) {
          if (e.target === this) {
            this.style.display = 'none';
          }
        });
      }
    });
  }

  // Initialize on page load
  document.addEventListener('DOMContentLoaded', initializeEnrollmentButtons);

  // Re-initialize on Turbo navigation
  document.addEventListener('turbo:load', initializeEnrollmentButtons);
  document.addEventListener('turbo:render', initializeEnrollmentButtons);
</script>
