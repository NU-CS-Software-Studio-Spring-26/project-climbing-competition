<% content_for :title, "Competition Details" %>

<section class="page-header text-center">
  <h1 class="page-title">competition details</h1>
</section>

<div class="action-row mb-2 d-flex gap-2 flex-wrap align-items-center">
  <%= link_to competitions_path, class: "back-arrow-text-link" do %>
    <span aria-hidden="true">←</span>
    back to all competitions
  <% end %>
</div>

<div class="detail-panel p-4 mb-3">
  <h2 class="detail-heading"><%= @competition.name %></h2>
  <p class="detail-item mb-0"><span>Created by:</span> <%= @competition.owner&.username %></p>
  <p class="detail-item mb-0"><span>Ends:</span> <%= @competition.date %></p>
  <% if @competition.description.present? %>
    <p class="detail-item mb-0"><span>Description:</span> <%= @competition.description %></p>
  <% end %>
</div>

<% if @competition.climbs.any? %>
  <div class="climbs-section mb-4">
    <h3 class="mb-3">Climbs</h3>
    <div class="action-row d-flex flex-column gap-3 align-items-start">
      <% @competition.climbs.each do |climb| %>
        <a href="<%= climb.url %>" target="_blank" class="climb-card-link">
          <span class="climb-card-title"><%= climb.name %></span>
          <span class="climb-card-subtitle">Open climb on Kilterboard</span>
        </a>
      <% end %>
    </div>
  </div>
<% end %>

