<% content_for :title, @competition.name %>

<div class="competition-show-shell">
  <div class="action-row mb-4 d-flex gap-2 flex-wrap align-items-center">
    <%= link_to competitions_path, class: "back-arrow-text-link" do %>
      <span aria-hidden="true">←</span>
      back to all competitions
    <% end %>
  </div>

  <header class="competition-page-header">
    <h1 class="competition-page-title"><%= @competition.name %></h1>
  </header>

  <section class="competition-section competition-hero-panel detail-panel">
    <div class="competition-hero-inner">
      <div class="competition-hero-top">
        <p class="competition-hero-stat mb-0">
          <%= competition_level_label(@competition) %>
          <span class="competition-hero-stat-sep" aria-hidden="true">|</span>
          Climbers: <%= @competition.users.count %>
        </p>

        <p class="competition-hero-dates mb-0">
          <%= competition_datetime_display(@competition.starts_at) %>
          <span class="competition-hero-separator" aria-hidden="true">–</span>
          <%= competition_datetime_display(@competition.ends_at) %>
        </p>

        <div class="competition-hero-top-end">
          <% if authenticated? && current_user == @competition.owner && @competition.owner_id.present? %>
            <%= button_to "Delete competition",
                  competition_path(@competition),
                  method: :delete,
                  class: "btn-competition-delete",
                  form: { data: { turbo_confirm: "Permanently delete this competition? All enrollments and attempts will be removed." } } %>
          <% else %>
            <p class="competition-hero-creator mb-0">
              creator:
              <% if @competition.owner %>
                <%= link_to_user_profile(@competition.owner, label: @competition.owner.name, class_name: "competition-hero-creator-link") %>
              <% else %>
                —
              <% end %>
            </p>
          <% end %>
        </div>
      </div>

      <% if @competition.description.present? %>
        <p class="competition-hero-description mb-0"><%= @competition.description %></p>
      <% end %>

      <% show_leave = authenticated? && current_user.competitions.include?(@competition) && @competition.leavable? %>
      <% show_join = @competition.joinable? && (!authenticated? || !current_user.competitions.include?(@competition)) %>
      <% if show_leave || show_join %>
        <div class="competition-hero-action">
          <% if show_leave %>
            <% enrollment = @competition.enrollments.find_by(user: current_user) %>
            <%= button_to "LEAVE", competition_enrollment_path(@competition, enrollment), method: :delete, class: "btn-leave-competition-show" %>
          <% elsif authenticated? %>
            <%= button_to "JOIN", competition_enrollments_path(@competition), method: :post, class: "btn-join-competition-show" %>
          <% else %>
            <%= link_to "JOIN", new_user_path, class: "btn-join-competition-show" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>

  <section class="competition-section competition-scoring-rules">
    <h2 class="competition-section-title text-center mb-3">Scoring Rules</h2>
    <div class="detail-panel scoring-rules-panel">
      <ul class="scoring-rules-list mb-0">
        <li>
          <span class="scoring-rules-label">Flash (1st attempt)</span>
          <span class="scoring-rules-value"><%= @competition.flash_points %> pts</span>
        </li>
        <li>
          <span class="scoring-rules-label">Send</span>
          <span class="scoring-rules-value"><%= @competition.send_points %> pts</span>
        </li>
        <li>
          <span class="scoring-rules-label">Per extra attempt</span>
          <span class="scoring-rules-value">&minus;<%= @competition.attempt_deduction %> pts</span>
        </li>
      </ul>
      <p class="scoring-rules-hint mb-0">
        Example: sending a problem on your 3rd attempt earns
        <%= [@competition.send_points - 2 * @competition.attempt_deduction, 0].max %> pts.
      </p>
    </div>
  </section>

  <% if @competition.climbs.any? %>
    <% climbs_with_visuals = @competition.climbs.select(&:visual?) %>
    <section class="competition-section competition-climbs-section"<% if climbs_with_visuals.any? %> data-controller="climb-visual-modal"<% end %>>
      <h2 class="competition-section-title text-center mb-3">Climbs</h2>
      <div class="climb-cards-grid">
        <% @competition.climbs.each do |climb| %>
          <% attempt = @user_attempts_by_climb_id[climb.id] %>
          <div class="climb-card-link">
            <div class="climb-card-grade-banner">
              <% if climb.grading.present? %>
                <span class="grade-badge <%= grade_css_class(climb.grading) %>"><%= climb.grading %></span>
              <% else %>
                <span class="grade-badge grade--ungraded">Ungraded</span>
              <% end %>
            </div>
            <div class="climb-card-body">
              <span class="climb-card-title"><%= climb.name %></span>
              <div class="climb-card-actions">
              <a href="<%= climb.url %>" target="_blank" rel="noopener noreferrer" class="btn-climb-action">OPEN ON KILTER</a>
              <% if climb.visual? %>
                <%= tag.button "VIEW CLIMB",
                      type: "button",
                      class: "btn-climb-action btn-climb-action-secondary",
                      data: {
                        action: "climb-visual-modal#open",
                        climb_visual_modal_climb_name_param: climb.name,
                        climb_visual_modal_climb_assignments_param: climb.hold_assignments
                      } %>
              <% end %>
              <% if authenticated? && current_user.competitions.include?(@competition) %>
                <%= link_to(attempt.present? ? "edit attempt" : "LOG ATTEMPT", competition_climb_path(@competition, climb), class: "btn-climb-action #{attempt.present? ? 'btn-climb-action-secondary' : 'btn-climb-action-primary'}") %>
              <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <% if climbs_with_visuals.any? %>
        <%= render "shared/climb_visual_view_modal" %>
      <% end %>
    </section>
  <% end %>

  <% if authenticated? && current_user.competitions.include?(@competition) %>
    <div class="competition-section">
      <div class="competition-points-pill">
        YOUR TOTAL POINTS: <%= @competition.points_for(current_user) %>
      </div>
    </div>
  <% end %>

  <% if @leaderboard_entries.any? %>
    <section id="leaderboard" class="competition-section competition-leaderboard-section">
      <h2 class="competition-section-title text-center mb-2">Leaderboard</h2>
      <p class="competition-section-caption text-center mb-4">click to see more details</p>
      <div class="detail-panel leaderboard-panel p-0">
        <div class="table-responsive">
          <table class="table table-borderless align-middle mb-0 leaderboard-table">
            <thead>
              <tr>
                <th scope="col">Rank</th>
                <th scope="col">Climber</th>
                <th scope="col">Points</th>
                <th scope="col">Total Attempts</th>
              </tr>
            </thead>
            <tbody>
              <% @leaderboard_entries.each_with_index do |entry, index| %>
                <tr class="<%= 'table-active' if authenticated? && entry.user == current_user %> leaderboard-user-row" style="cursor: pointer;" data-user-id="<%= entry.user.id %>" data-user-name="<%= entry.user.username %>" onclick="toggleLeaderboardDetails(this)">
                  <td><%= index + 1 %></td>
                  <td>
                    <%= link_to_user_profile(entry.user, label: entry.user.name, class_name: "profile-user-link", stop_row_toggle: true) %>
                  </td>
                  <td><%= entry.points %></td>
                  <td><%= entry.attempts_count %></td>
                </tr>
                <tr class="leaderboard-detail-row" style="display: none;" data-user-id="<%= entry.user.id %>">
                  <td colspan="4" class="leaderboard-detail-cell">
                    <div class="leaderboard-detail-card">
                      <h6 class="leaderboard-detail-title"><%= link_to_user_profile(entry.user, label: entry.user.name, class_name: "profile-user-link") %>'s Climb Attempts</h6>
                      <div class="table-responsive">
                        <table class="table table-sm table-borderless leaderboard-attempts-table mb-0">
                          <thead>
                            <tr>
                              <th>Climb</th>
                              <th>Attempts</th>
                              <th>Status</th>
                              <th>Points</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% @competition.climbs.each do |climb| %>
                              <% attempt = @attempts_by_user_and_climb[entry.user.id]&.[](climb.id) %>
                              <tr>
                                <td><strong><%= climb.name %></strong></td>
                                <% if attempt %>
                                  <td><%= attempt.attempt_count %></td>
                                  <td>
                                    <span class="<%= attempt.completed? ? 'text-success' : 'text-danger' %>">
                                      <%= attempt.completed? ? '✓ Completed' : '✗ Not Completed' %>
                                    </span>
                                  </td>
                                  <td><strong><%= attempt.points_awarded %> pts</strong></td>
                                <% else %>
                                  <td colspan="3" class="text-muted">Not attempted</td>
                                <% end %>
                              </tr>
                            <% end %>
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  <% end %>

  <script>
    function toggleLeaderboardDetails(rowElement) {
      const userId = rowElement.dataset.userId;
      const detailRow = document.querySelector(`.leaderboard-detail-row[data-user-id="${userId}"]`);

      document.querySelectorAll('.leaderboard-detail-row').forEach(row => {
        if (row !== detailRow && row.style.display !== 'none') {
          row.style.display = 'none';
        }
      });

      if (detailRow.style.display === 'none') {
        detailRow.style.display = 'table-row';
      } else {
        detailRow.style.display = 'none';
      }
    }

    function revealLeaderboardFromHash() {
      if (window.location.hash !== '#leaderboard') return;

      const leaderboard = document.getElementById('leaderboard');
      const currentUserRow = document.querySelector('.leaderboard-user-row.table-active');

      if (currentUserRow) {
        const detailRow = document.querySelector(`.leaderboard-detail-row[data-user-id="${currentUserRow.dataset.userId}"]`);
        if (detailRow && detailRow.style.display === 'none') {
          toggleLeaderboardDetails(currentUserRow);
        }
        currentUserRow.scrollIntoView({ block: 'start', behavior: 'smooth' });
        return;
      }

      leaderboard?.scrollIntoView({ block: 'start', behavior: 'smooth' });
    }

    document.addEventListener('DOMContentLoaded', revealLeaderboardFromHash);
    document.addEventListener('turbo:load', revealLeaderboardFromHash);
  </script>
</div>
