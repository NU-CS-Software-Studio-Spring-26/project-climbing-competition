<% content_for :title, "board base" %>

<section class="home-hero" aria-label="Board Base Hero">
  <div class="home-copy">
    <h1 class="home-title">board base</h1>
    <p class="home-subtitle">a virtual space for competitive climbing</p>
    <%= link_to "FIND EVENTS", competitions_path, class: "home-events-link" %>
    <div class="home-actions">
      <% if authenticated? %>
        <%= link_to "VIEW PROFILE", user_path(current_user), class: "home-action-link" %>
        <%= link_to "SIGN OUT", session_path, data: { turbo_method: :delete }, class: "home-action-link" %>
      <% else %>
        <%= link_to "SIGN UP", new_user_path, class: "home-action-link" %>
        <%= link_to "SIGN IN", new_session_path, class: "home-action-link" %>
      <% end %>
    </div>
  </div>

  <div class="home-kilter-wrap" aria-hidden="true">
    <%= image_tag "/kilter.svg", alt: "" %>
  </div>
</section>

<section class="about-section" aria-label="About">
  <div class="about-content">
    <h2 class="about-title">About Us</h2>
    <p class="about-text">
      Board Base is a platform for virtual bouldering competitions built on the Kilter Board.
      Set routes, invite competitors, and track results on a live leaderboard — all asynchronously,
      from any gym with a Kilter Board.
    </p>
    <p class="about-text">
      Built by Eric Wang, Ethan Pan, Ishani Pidara, and Hannah Kwak as part of CS-397 at Northwestern University.
    </p>
    <%= link_to "View on GitHub", "https://github.com/NU-CS-Software-Studio-Spring-26/project-climbing-competition",
          target: "_blank", rel: "noopener noreferrer", class: "about-github-link" %>
  </div>
</section>