<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Climbing Competition" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="board base">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Host+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="app-shell <%= "home-shell" if controller_name == "home" && action_name == "index" %>">
    <h1 class="visually-hidden">Board Base</h1>

    <% if controller_name == "home" && action_name == "index" %>
      <main class="home-main">
        <div class="home-stack">
          <%= render "shared/flashes" %>
          <%= yield %>
        </div>
      </main>
    <% else %>
      <header class="app-topbar">
        <%= link_to "board base", root_path, class: "app-brand" %>

        <nav class="app-nav app-nav--top" aria-label="Primary">
          <%= link_to "competitions", competitions_path, class: "app-nav-link #{controller_name == "competitions" && action_name == "index" ? "is-active" : ""}" %>
          <%= link_to "create", new_competition_path, class: "app-nav-link #{controller_name == "competitions" && action_name == "new" ? "is-active" : ""}" %>
          <% if authenticated? %>
            <%= link_to "friends", friends_path, class: "app-nav-link #{controller_name == "friends" ? "is-active" : ""}" %>
            <%= link_to current_user.username, user_path(current_user), class: "app-nav-link #{controller_name == "users" && action_name == "show" ? "is-active" : ""}" %>
            <%= link_to "sign out", session_path, data: { turbo_method: :delete }, class: "app-nav-link" %>
          <% else %>
            <%= link_to "sign in", new_session_path, class: "app-nav-link #{controller_name == "sessions" && action_name == "new" ? "is-active" : ""}" %>
          <% end %>
        </nav>
      </header>

      <main class="app-page pb-5">
        <div class="app-page-inner">
          <%= render "shared/flashes" %>
          <%= yield %>
        </div>
      </main>
    <% end %>

    <%= render "shared/footer" %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
  </body>
</html>
