<div class="profile-competition-row">
  <div class="profile-competition-row__main">
    <%= link_to competition.name, competition_path(competition), class: "profile-competition-row__title" %>
    <p class="profile-competition-row__meta mb-0">
      <%= competition.climb_grade_range_label || competition.level.to_s.titleize %>
      · <%= competition.starts_at&.strftime("%b %-d, %Y %l:%M %p") %> – <%= competition.ends_at&.strftime("%b %-d, %Y %l:%M %p") %>
      <% if local_assigns[:placement].present? %>
        · Placed <%= placement_label(placement) %>
      <% end %>
    </p>
  </div>
  <% if local_assigns[:show_delete] %>
    <%= button_to "Delete", competition_path(competition), method: :delete, params: { return_to: local_assigns[:return_to] }, class: "btn btn-sm profile-btn-delete flex-shrink-0", form: { data: { turbo_confirm: "Permanently delete this competition? All enrollments and attempts will be removed." } } %>
  <% end %>
</div>
