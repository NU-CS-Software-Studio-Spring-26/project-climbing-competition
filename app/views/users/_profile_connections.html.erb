<section class="profile-panel profile-collapsible-panel profile-connections-panel" data-controller="profile-tabs">
  <details class="profile-collapsible-dropdown">
    <summary class="profile-collapsible-dropdown__summary">
      <span class="profile-collapsible-dropdown__title">Connections</span>
      <span class="profile-collapsible-dropdown__counts"><%= following_count %> following · <%= followers_count %> followers</span>
    </summary>

    <div class="profile-collapsible-dropdown__body">
      <div class="profile-tabs" role="tablist" aria-label="Connections">
        <button type="button"
                class="profile-tabs__tab is-active"
                role="tab"
                id="profile-tab-following"
                aria-selected="true"
                aria-controls="profile-panel-following"
                data-profile-tabs-target="tab"
                data-profile-tabs-tab-param="following"
                data-action="profile-tabs#show">
          Following (<%= following_count %>)
        </button>
        <button type="button"
                class="profile-tabs__tab"
                role="tab"
                id="profile-tab-followers"
                aria-selected="false"
                aria-controls="profile-panel-followers"
                data-profile-tabs-target="tab"
                data-profile-tabs-tab-param="followers"
                data-action="profile-tabs#show">
          Followers (<%= followers_count %>)
        </button>
      </div>

      <div class="profile-tabs__panels">
        <div class="profile-tabs__panel"
             role="tabpanel"
             id="profile-panel-following"
             aria-labelledby="profile-tab-following"
             data-profile-tabs-target="panel"
             data-profile-tabs-panel-param="following">
          <% if following_users.any? %>
            <div class="profile-user-list">
              <%= render partial: "users/profile_user_row", collection: following_users, as: :user %>
            </div>
          <% else %>
            <p class="profile-empty-state mb-0">You are not following anyone yet.</p>
          <% end %>
        </div>

        <div class="profile-tabs__panel"
             role="tabpanel"
             id="profile-panel-followers"
             aria-labelledby="profile-tab-followers"
             hidden
             data-profile-tabs-target="panel"
             data-profile-tabs-panel-param="followers">
          <% if follower_users.any? %>
            <div class="profile-user-list">
              <%= render partial: "users/profile_user_row", collection: follower_users, as: :user %>
            </div>
          <% else %>
            <p class="profile-empty-state mb-0">No followers yet.</p>
          <% end %>
        </div>
      </div>
    </div>
  </details>
</section>
