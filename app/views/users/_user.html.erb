<div id="<%= dom_id user %>">
  <div>
    <strong>Name:</strong>
    <%= user.name %>
  </div>

  <div>
    <strong>Username:</strong>
    <%= user.username %>
  </div>

  <div>
    <strong>Email:</strong>
    <%= user.email_address %>
  </div>

  <div>
    <strong>Bio:</strong>
    <%= user.bio.presence || "No bio added yet." %>
  </div>

</div>
