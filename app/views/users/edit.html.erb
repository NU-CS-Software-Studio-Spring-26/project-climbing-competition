<% content_for :title, "Edit profile" %>

<div class="profile-shell">
  <section class="profile-panel profile-panel--hero">
    <p class="profile-eyebrow mb-2">profile settings</p>
    <h1 class="profile-hero-title">edit profile</h1>
  </section>

  <section class="profile-panel">
    <%= render "form", user: @user %>
  </section>

  <div class="profile-actions profile-actions--standalone">
    <%= link_to "Back to profile", @user, class: "back-arrow-text-link" %>
  </div>
</div>
