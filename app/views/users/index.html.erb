<% content_for :title, "Profiles" %>

<section class="page-header">
  <h1 class="page-title">profiles</h1>
</section>

<div id="users">
  <% @users.each do |user| %>
    <%= render user %>
    <p>
      <%= link_to "View profile", user %>
    </p>
  <% end %>
</div>

<%= link_to "Sign up", new_user_path, class: "btn btn-board-primary" %>
