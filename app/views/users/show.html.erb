<% content_for :title, @user.username %>

<section class="detail-panel p-4 mb-3">
  <div class="d-flex flex-column gap-3">
    <div>
      <p class="eyebrow mb-1">profile</p>
      <h1 class="page-title page-title-left"><%= @user.name %></h1>
      <p class="mb-0"><%= "@#{@user.username}" %></p>
    </div>

    <div class="d-flex flex-column gap-2">
      <% if @profile_owner %>
        <p class="detail-item mb-0"><span>Email:</span> <%= @user.email_address %></p>
      <% end %>
      <p class="detail-item mb-0"><span>Bio:</span> <%= @user.bio.presence || "No bio added yet." %></p>
    </div>

    <div class="action-row d-flex gap-2 flex-wrap">
      <% if @profile_owner %>
        <%= link_to "Edit profile", edit_user_path(@user), class: "btn btn-board-primary" %>
      <% end %>
      <%= link_to "Back to events", competitions_path, class: "btn btn-board-secondary" %>
    </div>
  </div>
</section>

<section class="detail-panel p-4 mb-3">
  <h2 class="h5 mb-3">Upcoming competitions</h2>
  <% if @enrolled_upcoming.any? %>
    <%= render collection: @enrolled_upcoming, partial: "users/profile_competition_row", as: :competition, locals: { show_delete: false } %>
  <% else %>
    <p class="mb-0 profile-empty-state">No upcoming competitions.</p>
  <% end %>
</section>

<section class="detail-panel p-4 mb-3">
  <h2 class="h5 mb-3">Active competitions</h2>
  <% if @enrolled_active.any? %>
    <%= render collection: @enrolled_active, partial: "users/profile_competition_row", as: :competition, locals: { show_delete: false } %>
  <% else %>
    <p class="mb-0 profile-empty-state">No active competitions.</p>
  <% end %>
</section>

<section class="detail-panel p-4 mb-3">
  <h2 class="h5 mb-3">Past competitions</h2>
  <% if @enrolled_past.any? %>
    <%= render collection: @enrolled_past, partial: "users/profile_competition_row", as: :competition, locals: { show_delete: false } %>
  <% else %>
    <p class="mb-0 profile-empty-state">No past competitions.</p>
  <% end %>
</section>

<section class="detail-panel p-4 mb-3">
  <h2 class="h5 mb-3">Created competitions</h2>
  <% if @created_competitions.any? %>
    <% @created_competitions.each do |competition| %>
      <%= render "users/profile_competition_row", competition: competition, show_delete: @profile_owner, return_to: user_path(@user) %>
    <% end %>
  <% else %>
    <p class="mb-0 profile-empty-state">No created competitions.</p>
  <% end %>
</section>
