<% content_for :title, @user.username %>

<div class="profile-shell">
  <section class="profile-panel profile-panel--hero">
    <div class="profile-hero-layout">
      <div class="profile-hero-main">
        <p class="profile-eyebrow mb-2">profile</p>
        <h1 class="profile-hero-title"><%= @user.name %></h1>
        <p class="profile-username mb-3"><%= "@#{@user.username}" %></p>

        <div class="profile-meta">
          <p class="profile-meta-item mb-0"><span class="profile-meta-label">Bio</span> <%= @user.bio.presence || "No bio added yet." %></p>
        </div>

        <div class="profile-actions">
          <% if @profile_owner %>
            <%= link_to "Edit profile", edit_user_path(@user), class: "btn btn-board-primary" %>
          <% elsif authenticated? %>
            <% if @is_following %>
              <%= button_to "Unfollow", user_follow_path(@user), method: :delete, class: "btn btn-board-secondary" %>
            <% else %>
              <%= button_to "Follow", user_follow_path(@user), method: :post, class: "btn btn-board-primary" %>
            <% end %>
          <% end %>
          <%= link_to "Back to events", competitions_path, class: "btn btn-board-secondary" %>
        </div>
      </div>

      <aside class="profile-hero-aside" aria-label="Profile details">
        <div class="profile-aside-item">
          <span class="profile-aside-label">Member since</span>
          <span class="profile-aside-value"><%= @user.created_at.strftime("%B %Y") %></span>
        </div>
        <% if @profile_owner %>
          <div class="profile-aside-item">
            <span class="profile-aside-label">Email</span>
            <span class="profile-aside-value profile-aside-value--email"><%= @user.email_address %></span>
          </div>
        <% end %>
      </aside>
    </div>
  </section>

  <section class="profile-panel profile-stats-panel" aria-label="Competition statistics">
    <h2 class="profile-section-title">Stats</h2>
    <div class="profile-stats-grid">
      <div class="profile-stat">
        <p class="profile-stat-value mb-0"><%= @participated_count %></p>
        <p class="profile-stat-label mb-0">Competitions entered</p>
      </div>
      <div class="profile-stat">
        <p class="profile-stat-value mb-0"><%= format_average_placement(@average_placement) %></p>
        <p class="profile-stat-label mb-0">Average placement</p>
        <p class="profile-stat-hint mb-0">Past events only</p>
      </div>
      <div class="profile-stat">
        <p class="profile-stat-value mb-0"><%= @created_count %></p>
        <p class="profile-stat-label mb-0">Competitions created</p>
      </div>
    </div>
  </section>

  <% if @profile_owner %>
    <%= render "users/profile_connections",
          following_users: @following_users,
          follower_users: @follower_users,
          following_count: @following_count,
          followers_count: @followers_count %>
  <% end %>

  <%= render "users/profile_competitions",
        user: @user,
        profile_owner: @profile_owner,
        enrolled_current: @enrolled_current,
        enrolled_past: @enrolled_past,
        past_placements: @past_placements,
        created_competitions: @created_competitions %>
</div>
